<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#FFF3E0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/et_ner_input"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_margin="8dp"
        android:gravity="top|start"
        android:hint="粘贴或输入待扫描的中文文本…"
        android:inputType="textMultiLine"
        android:background="#F5F5F5"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/status_banner"/>

    <LinearLayout
        android:id="@+id/ner_action_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/et_ner_input">

        <Spinner
            android:id="@+id/spinner_backend"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_recognize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="识别"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_highlight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/ner_action_row"
        app:layout_constraintBottom_toTopOf="@id/rv_entities"
        app:layout_constraintHeight_percent="0.3"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_entities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_highlight"
        app:layout_constraintBottom_toTopOf="@id/tv_ner_stats"/>

    <TextView
        android:id="@+id/tv_ner_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="12sp"
        android:background="#EEEEEE"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
